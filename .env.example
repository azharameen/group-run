# LLM Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://your-custom-endpoint.com/v1
OPENAI_MODEL_NAME=gpt-4o

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Workflow Configuration
WORKFLOW_SCHEDULER_ENABLED=false
WORKFLOW_INTERVAL_MINUTES=15
MAX_RETRIES_PER_STATE=3
COMPOSITE_THRESHOLD=70
GATE_THRESHOLD_PERCENT=50

# MCP Server Configuration (optional)
# JSON object mapping server names to connection configs.
# Example: {"patent-search":{"transport":"http","url":"http://localhost:8001/mcp"}}
# See: https://docs.langchain.com/oss/python/deepagents/tools#mcp-tools
MCP_SERVERS=
