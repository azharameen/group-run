# =============================================================================
# Companion — Agentic Organization Platform
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# See docs/GETTING_STARTED.md for a full onboarding guide.
# =============================================================================

# CI/local deterministic fallback only. Production models should be managed
# through Settings → Provider and persisted in PostgreSQL.
DEEPAGENTS_MODEL=""

# Required to encrypt user-managed provider credentials at rest. Generate a
# Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not rotate this value without a credential re-encryption migration.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=""

# ── LangSmith Tracing (OPTIONAL) ────────────────────────────────────────────
# Enable LangSmith to trace prompts, tool calls, and agent runs for
# debugging and observability. NOTE: this ships data to LangSmith.
# Do NOT enable with sensitive prompts in production.
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ideator"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_ENABLED=False

# ── Backend Server (OPTIONAL — defaults shown) ──────────────────────────────
# Host and port for the FastAPI backend server.
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# ── MCP Servers (OPTIONAL) ─────────────────────────────────────────────────
# JSON string specifying MCP (Model Context Protocol) server configurations.
# Tools loaded via MCP bypass the permissions model (ADR-013) — treat as
# untrusted. Format follows langchain-mcp-adapters configuration schema.
# Leave blank to disable MCP tool loading.
MCP_SERVERS=""

# ── LangGraph Configuration (REQUIRED) ──────────────────────────────────────
# MUST be set to "true" for LangGraph checkpoint serialization safety.
# The application will raise an error if this is set to any value other
# than "true".
LANGGRAPH_STRICT_MSGPACK=true

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Runtime URL — used by the FastAPI app and LangGraph checkpointer (asyncpg).
# Local dev: connects to the postgres container defined in docker-compose.yml.
# Production (Supabase): use Transaction Pooler URL (port 6543) for runtime.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/app_db"

# Direct connection URL — used ONLY by Alembic schema migrations (psycopg v3).
# Requires a persistent connection; do not use a PgBouncer pooler URL here.
# Production (Supabase): use the Direct Connection URL (port 5432) for DDL.
DATABASE_DIRECT_URL="postgresql+psycopg://postgres:postgres@localhost:5432/app_db"

# SSL mode for the database connection.
# Use 'prefer' for local dev (plain TCP) and 'require' for Supabase production.
DB_SSL_MODE="prefer"

# SQLAlchemy async connection pool bounds.
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=30

# When true, runs 'alembic upgrade head' automatically at application startup.
# Set to false in production — migrations are run by the CI/CD pipeline instead.
DB_AUTO_MIGRATE=true

# ── Agent Runtime (OPTIONAL) ────────────────────────────────────────────────
# Agent operation timeout in seconds (default: 120).
AGENT_TIMEOUT_SEC=120

# ── Application Root (REQUIRED for Docker) ──────────────────────────────────
# In Docker, this MUST be set to "/app" because the Dockerfile layout differs
# from the local checkout (no intermediate "backend" folder).
# Locally, this is auto-detected — only set if you need to override.
# APP_ROOT_DIR=/app

# ── Frontend / Vite (OPTIONAL) ──────────────────────────────────────────────
# The API URL the frontend uses. For local dev with Vite's proxy,
# VITE_API_PROXY sets the proxy target in vite.config.ts.
VITE_API_URL="http://localhost:8000"

# Firebase web configuration is public application metadata, not a service
# account credential. Set these for local and CI builds.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Backend Firebase Admin SDK. Cloud Run uses Application Default Credentials.
FIREBASE_PROJECT_ID=""
# Local emulator examples (never set emulator hosts in production):
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8085"
# VITE_FIREBASE_AUTH_EMULATOR_URL="http://127.0.0.1:9099"
# VITE_FIRESTORE_EMULATOR_HOST="127.0.0.1:8085"

# ── Playwright E2E Testing (OPTIONAL) ───────────────────────────────────────
# Base URLs for Playwright test projects. Usually only needed for CI.
PLAYWRIGHT_DEV_BASE_URL="http://localhost:3000"
PLAYWRIGHT_DOCKER_BASE_URL="http://localhost:3000"
