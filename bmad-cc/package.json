{
  "name": "bmad-cc",
  "version": "0.1.0",
  "description": "BMad Agentic Development Command Center - Autonomous sprint execution engine",
  "type": "module",
  "bin": {
    "bmad-cc": "./dist/bmad-cc.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/bmad-cc.ts",
